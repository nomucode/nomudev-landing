---
// Service pages in English: /en/web-development-valencia/, /en/custom-erp-development/…
import ServicePage from '../../infrastructure/ui/templates/ServicePage.astro';
import { ProjectService } from '../../application/ProjectService';

export function getStaticPaths() {
  return ProjectService.getCategories('en').map((category) => ({
    params: { service: category.slug },
    props: { id: category.id },
  }));
}

const { id } = Astro.props;
---

<ServicePage id={id} />
