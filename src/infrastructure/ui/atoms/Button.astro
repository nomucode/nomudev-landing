---
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'a'>, 'class'> & {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'link';
  size?: 'sm' | 'md' | 'lg';
  external?: boolean;
  class?: string;
};

const { href, variant = 'primary', size = 'md', external = false, class: className, ...attrs } = Astro.props;

const baseStyles =
  "group/btn inline-flex items-center justify-center gap-2 rounded-md font-medium whitespace-nowrap transition-all duration-150 ease-(--ease-out-soft) disabled:opacity-50 disabled:pointer-events-none";

const variants = {
  primary: "bg-primary text-canvas hover:bg-primary-hover hover:shadow-glow",
  secondary: "border border-line bg-raised text-fg hover:border-line-strong hover:bg-overlay",
  ghost: "text-fg-muted hover:text-fg hover:bg-raised",
  link: "text-primary hover:text-primary-hover underline-offset-4 hover:underline px-0! h-auto!",
};

const sizes = {
  sm: "h-9 px-3.5 text-sm",
  md: "h-11 px-5 text-ui",
  lg: "h-12 px-6 text-base",
};

const classes = [baseStyles, variants[variant], sizes[size], className].filter(Boolean).join(' ');
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{
  href ? (
    <a href={href} class={classes} {...externalAttrs} {...attrs}>
      <slot />
    </a>
  ) : (
    <button type="button" class={classes} {...(attrs as HTMLAttributes<'button'>)}>
      <slot />
    </button>
  )
}
