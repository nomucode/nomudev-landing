---
interface Props {
  tone?: 'neutral' | 'primary' | 'success';
  class?: string;
}

const { tone = 'neutral', class: className } = Astro.props;

const baseStyles =
  "inline-flex items-center gap-1.5 rounded-sm border px-2 py-1 font-mono text-xs leading-none font-medium tracking-[0.02em]";

const tones = {
  neutral: "border-line bg-raised text-fg-muted",
  primary: "border-primary/25 bg-primary/10 text-primary",
  success: "border-success/25 bg-success/10 text-success",
};
---

<span class={[baseStyles, tones[tone], className].filter(Boolean).join(' ')}>
  <slot />
</span>
