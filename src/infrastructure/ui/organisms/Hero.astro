---
import Button from '../atoms/Button.astro';
import Badge from '../atoms/Badge.astro';
import StatusDot from '../atoms/StatusDot.astro';
import ProductBento from '../molecules/ProductBento.astro';
import { AVAILABILITY, LINKEDIN_URL, PROFILE } from '../../../application/ProfileService';
import { getLang, useTranslations } from '../../../i18n';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang).hero;
---

<section class="relative isolate overflow-hidden pt-16 pb-20 sm:pt-24 sm:pb-28">
  <!-- Fondo: dot-grid + aurora -->
  <div class="bg-dots pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -top-40 right-[-10%] -z-10 size-160 rounded-full bg-primary opacity-[0.12] blur-[120px]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute top-40 left-[-15%] -z-10 size-120 rounded-full bg-success opacity-[0.06] blur-[120px]" aria-hidden="true"></div>

  <div class="container-page grid items-center gap-16 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-7">
      <div class="hero-in" style="--i: 0">
        <Badge tone="success">
          <StatusDot />
          <span class="hidden sm:inline">{t.badgeLead}</span> {t.badge(AVAILABILITY.slots, AVAILABILITY.period[lang])}
        </Badge>
      </div>

      <h1 class="hero-in mt-8 text-display font-bold" style="--i: 1">
        {t.h1Before}<span class="text-gradient">{t.h1Gradient}</span>{t.h1After}
      </h1>

      <p class="hero-in mt-6 max-w-[60ch] text-lead text-fg-muted" style="--i: 2">
        {t.lead(PROFILE.name)}
      </p>

      <div class="hero-in mt-10 flex flex-wrap items-center gap-3" style="--i: 3">
        <Button href={LINKEDIN_URL} external size="lg" aria-label={t.ctaPrimaryAria}>
          {t.ctaPrimary}
          <span aria-hidden="true">↗</span>
        </Button>
        <Button href="#work" variant="secondary" size="lg">
          {t.ctaSecondary}
          <span aria-hidden="true" class="transition-transform group-hover/btn:translate-x-0.5">→</span>
        </Button>
      </div>

      <p class="hero-in mt-8 text-sm text-fg-subtle" style="--i: 4">{t.proof}</p>
    </div>

    <div class="hero-in lg:col-span-5" style="--i: 3">
      <ProductBento />
    </div>
  </div>
</section>

<style>
  .hero-in {
    animation: hero-in 700ms var(--ease-out-soft) both;
    animation-delay: calc(var(--i, 0) * 80ms);
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
</style>
