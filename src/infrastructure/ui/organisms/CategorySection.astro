---
import { Globe, AppWindow, Monitor, Layers, Hourglass } from 'lucide-astro';
import type { Project, ProjectCategoryInfo } from '../../../domain/models';
import ProjectCard from '../molecules/ProjectCard.astro';
import BentoCell from '../molecules/BentoCell.astro';
import { getLang, useTranslations } from '../../../i18n';

interface Props {
  category: ProjectCategoryInfo;
  projects: Project[];
  index: number;
}

const { category, projects, index } = Astro.props;

const icons = {
  'globe': Globe,
  'app-window': AppWindow,
  'monitor': Monitor,
  'layers': Layers,
};
const Icon = icons[category.icon];
const number = String(index + 1).padStart(2, '0');
const t = useTranslations(getLang(Astro.currentLocale)).work;
---

<section
  id={`work-${category.id}`}
  class={`grid scroll-mt-32 gap-8 py-16 lg:grid-cols-12 lg:gap-12 lg:py-20 ${index > 0 ? 'border-t border-line' : ''}`}
  style={`--cat: ${category.color}`}
  aria-labelledby={`work-${category.id}-title`}
>
  <!-- Cabecera de la categoría (fija en escritorio) -->
  <header class="lg:col-span-4" data-reveal>
    <div class="lg:sticky lg:top-36">
      <div class="flex items-center gap-3">
        <span class="flex size-10 items-center justify-center rounded-md border border-line bg-raised text-(--cat)">
          <Icon class="size-5" stroke-width={1.5} />
        </span>
        <span class="font-mono text-eyebrow uppercase text-fg-subtle">{number} {t.of} 04</span>
      </div>

      <h3 id={`work-${category.id}-title`} class="mt-6 text-title font-semibold">
        {category.label}
      </h3>
      <p class="mt-3 text-lg text-fg-body">{category.headline}</p>
      <a href={category.href} class="mt-4 inline-flex text-sm text-fg-muted underline-offset-4 transition-colors hover:text-(--cat) hover:underline">{t.includes} →</a>
    </div>
  </header>

  <!-- Proyectos de la categoría -->
  <div class="grid content-start gap-4 md:grid-cols-2 lg:col-span-8">
    {projects.length > 0 ? (
      projects.map((project, i) => (
        <ProjectCard
          project={project}
          featured={i === 0}
          headingLevel={4}
          revealIndex={i % 2}
          class={i === 0 || (projects.length === 2) ? 'md:col-span-2' : ''}
        />
      ))
    ) : (
      <BentoCell class="flex min-h-64 flex-col items-center justify-center gap-4 border-dashed bg-transparent p-8 text-center shadow-none md:col-span-2">
        <Hourglass class="size-6 text-(--cat)" stroke-width={1.5} />
        <p class="font-mono text-eyebrow uppercase text-fg-subtle">{t.emptyTag}</p>
        <p class="max-w-sm text-fg-muted">{t.empty(category.label)}</p>
      </BentoCell>
    )}
  </div>
</section>
