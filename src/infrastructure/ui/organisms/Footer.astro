---
import { Image } from 'astro:assets';
import logo from '../../../assets/brand/nomudev-mark.png';
import { LINKEDIN_URL } from '../../../application/ProfileService';
import { ProjectService } from '../../../application/ProjectService';
import { LOCALE_META, getLang, useTranslations, type Lang } from '../../../i18n';

interface Props {
  alternates: Record<Lang, string>;
}

const { alternates } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const services = ProjectService.getCategories(lang);
const otherLang: Lang = lang === 'es' ? 'en' : 'es';
const year = new Date().getFullYear();
const link = 'transition-colors hover:text-primary';
---

<footer class="border-t border-line">
  <div class="container-page grid gap-10 py-12 text-sm md:grid-cols-[1.2fr_1fr_auto]">
    <div>
      <div class="flex items-center gap-3">
        <Image src={logo} alt="" width={24} height={24} densities={[1, 2]} class="size-6 object-contain opacity-80" />
        <span class="font-mono text-sm font-semibold text-fg">nomudev</span>
      </div>
      <p class="mt-3 max-w-xs text-fg-muted">{t.footer.tagline}</p>
      <p class="mt-6 text-fg-subtle">&copy; {year} Noel Muñoz · nomudev</p>
    </div>

    <nav aria-label={t.footer.servicesTitle}>
      <p class="font-mono text-eyebrow uppercase text-fg-subtle">{t.footer.servicesTitle}</p>
      <ul class="mt-3 space-y-2 text-fg-muted">
        {services.map((service) => (
          <li><a href={service.href} class={link}>{service.label}</a></li>
        ))}
      </ul>
    </nav>

    <ul class="space-y-2 text-fg-muted md:text-right">
      <li><a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class={link}>LinkedIn ↗</a></li>
      <li><a href="/privacy/" class={link}>{t.footer.privacy}</a></li>
      <li><a href={alternates[otherLang]} hreflang={otherLang} lang={otherLang} class={link}>{LOCALE_META[otherLang].label}</a></li>
      <li class="text-fg-subtle">{t.footer.builtWith}</li>
    </ul>
  </div>
</footer>
