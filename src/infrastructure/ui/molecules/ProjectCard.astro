---
import type { Project } from '../../../domain/models';
import Badge from '../atoms/Badge.astro';
import BentoCell from './BentoCell.astro';
import StatBlock from './StatBlock.astro';

interface Props {
  project: Project;
  featured?: boolean;
  revealIndex?: number;
  headingLevel?: 3 | 4;
  class?: string;
}

const { project, featured = false, revealIndex = 0, headingLevel = 3, class: className } = Astro.props;
const Heading = `h${headingLevel}` as 'h3' | 'h4';
const [stat] = project.stats ?? [];
---

<BentoCell
  as="article"
  class={`group flex h-full flex-col p-6 sm:p-8 ${className ?? ''}`}
  style={`--reveal-i: ${revealIndex}`}
>
  <!-- Línea de acento superior -->
  <div class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-(--cat,var(--color-primary)) to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>

  <div class="relative flex flex-wrap gap-2">
    {project.techStack.map((tech) => <Badge>{tech}</Badge>)}
  </div>

  <div class={`relative mt-auto ${featured ? 'pt-12 sm:pt-16' : 'pt-10'}`}>
    {stat && (
      <dl class="mb-6">
        <StatBlock value={stat.value} label={stat.label} tone="category" />
      </dl>
    )}

    <Heading class={`font-semibold ${featured ? 'text-title' : 'text-h3'}`}>
      {project.title}
    </Heading>
    <p class={`mt-3 text-fg-muted leading-relaxed ${featured ? 'max-w-xl' : ''}`}>
      {project.description}
    </p>
  </div>
</BentoCell>
