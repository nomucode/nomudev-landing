---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'div'> & {
  as?: 'div' | 'article' | 'li';
};

const { as: Tag = 'div', class: className, ...attrs } = Astro.props;
---

<Tag class={['bento-cell', className].filter(Boolean).join(' ')} data-reveal {...attrs}>
  <slot />
</Tag>

<script>
  // Un único listener delegado: actualiza --x / --y para el spotlight de la celda bajo el cursor
  if (window.matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
    document.addEventListener('pointermove', (e) => {
      const cell = (e.target as Element | null)?.closest?.<HTMLElement>('.bento-cell');
      if (!cell) return;
      const rect = cell.getBoundingClientRect();
      cell.style.setProperty('--x', `${e.clientX - rect.left}px`);
      cell.style.setProperty('--y', `${e.clientY - rect.top}px`);
    }, { passive: true });
  }
</script>
