---
import type { ProjectCategory } from '../../../domain/models';
import { getLang, useTranslations } from '../../../i18n';

// Ilustración abstracta por servicio. Hereda el color de la categoría vía --cat.
interface Props {
  id: ProjectCategory;
}

const { id } = Astro.props;
const d = useTranslations(getLang(Astro.currentLocale)).decor;

const line = 'var(--color-line-strong)';
const soft = 'var(--color-line)';
const text = 'var(--color-fg-subtle)';
const accent = 'var(--cat)';
---

<div class="relative overflow-hidden rounded-lg border border-line bg-canvas/60" aria-hidden="true">
  <div class="bg-dots absolute inset-0 opacity-60"></div>
  <svg viewBox="0 0 320 132" class="relative block h-auto w-full" fill="none" font-family="var(--font-mono)">
    {id === 'landing' && (
      <g>
        <rect x="40" y="16" width="240" height="104" rx="8" stroke={line} />
        <line x1="40" y1="34" x2="280" y2="34" stroke={soft} />
        <circle cx="52" cy="25" r="2.5" fill={line} /><circle cx="61" cy="25" r="2.5" fill={line} /><circle cx="70" cy="25" r="2.5" fill={line} />
        <rect x="58" y="48" width="120" height="8" rx="2" fill={line} />
        <rect x="58" y="62" width="86" height="8" rx="2" fill={line} />
        <rect x="58" y="78" width="140" height="4" rx="2" fill={soft} />
        <rect x="58" y="94" width="58" height="14" rx="3" fill={accent} />
        <rect x="214" y="48" width="48" height="56" rx="4" stroke={soft} />
        <path d="M222 92 L232 80 L240 86 L254 66" stroke={accent} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="104" cy="104" r="10" stroke={accent} stroke-opacity="0.35" />
        <circle cx="104" cy="104" r="16" stroke={accent} stroke-opacity="0.15" />
        <path d="M102 101 L102 117 L106 113 L109 120 L112 119 L109 112 L114 112 Z" fill="var(--color-fg)" stroke="var(--color-canvas)" stroke-width="1" />
      </g>
    )}
    {id === 'webapp' && (
      <g>
        <rect x="24" y="30" width="72" height="72" rx="8" stroke={line} />
        <rect x="34" y="42" width="52" height="5" rx="2" fill={line} />
        <path d="M34 88 L46 78 L56 82 L68 64 L86 58" stroke={accent} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        <text x="60" y="118" text-anchor="middle" font-size="9" fill={text}>{d.client}</text>
        <rect x="128" y="44" width="64" height="44" rx="8" stroke={accent} />
        <text x="160" y="70" text-anchor="middle" font-size="10" fill={accent}>API</text>
        <text x="160" y="118" text-anchor="middle" font-size="9" fill={text}>cloud run</text>
        <ellipse cx="256" cy="46" rx="28" ry="8" stroke={line} />
        <path d="M228 46 V86 A28 8 0 0 0 284 86 V46" stroke={line} />
        <path d="M228 66 A28 8 0 0 0 284 66" stroke={soft} />
        <text x="256" y="118" text-anchor="middle" font-size="9" fill={text}>{d.data}</text>
        <line x1="96" y1="66" x2="128" y2="66" stroke={line} stroke-dasharray="3 3" />
        <line x1="192" y1="66" x2="228" y2="66" stroke={line} stroke-dasharray="3 3" />
        <circle cx="112" cy="66" r="3" fill={accent} />
        <circle cx="210" cy="66" r="3" fill={accent} />
      </g>
    )}
    {id === 'desktop' && (
      <g>
        <rect x="56" y="14" width="150" height="92" rx="8" stroke={line} />
        <line x1="131" y1="106" x2="131" y2="118" stroke={line} />
        <line x1="106" y1="118" x2="156" y2="118" stroke={line} stroke-linecap="round" />
        <rect x="68" y="26" width="126" height="68" rx="4" stroke={soft} />
        <rect x="68" y="26" width="30" height="68" rx="4" fill={accent} fill-opacity="0.12" />
        <rect x="74" y="36" width="18" height="4" rx="2" fill={accent} />
        <rect x="74" y="46" width="18" height="4" rx="2" fill={soft} />
        <rect x="74" y="56" width="18" height="4" rx="2" fill={soft} />
        <rect x="106" y="36" width="78" height="30" rx="3" stroke={soft} />
        <rect x="106" y="74" width="56" height="4" rx="2" fill={soft} />
        <path d="M232 48 a18 18 0 1 1 0 36" stroke={accent} stroke-width="1.5" stroke-linecap="round" />
        <path d="M228 80 l4 4 l-4 4" stroke={accent} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        <text x="258" y="70" font-size="9" fill={text}>{d.sync}</text>
        <rect x="236" y="98" width="30" height="16" rx="3" stroke={line} />
        <line x1="242" y1="106" x2="260" y2="106" stroke={soft} />
        <line x1="206" y1="106" x2="236" y2="106" stroke={line} stroke-dasharray="3 3" />
      </g>
    )}
    {id === 'erp' && (
      <g>
        <rect x="16" y="46" width="62" height="40" rx="8" stroke={line} />
        <text x="47" y="70" text-anchor="middle" font-size="9" fill={text}>{d.order}</text>
        <rect x="94" y="46" width="62" height="40" rx="8" stroke={line} />
        <text x="125" y="70" text-anchor="middle" font-size="9" fill={text}>{d.stock}</text>
        <rect x="172" y="46" width="62" height="40" rx="8" stroke={accent} />
        <text x="203" y="70" text-anchor="middle" font-size="9" fill={accent}>{d.invoice}</text>
        <rect x="250" y="46" width="54" height="40" rx="8" stroke={line} />
        <rect x="260" y="70" width="6" height="8" fill={accent} fill-opacity="0.5" />
        <rect x="270" y="62" width="6" height="16" fill={accent} fill-opacity="0.75" />
        <rect x="280" y="56" width="6" height="22" fill={accent} />
        <path d="M78 66 H90 M86 62 l4 4 l-4 4" stroke={line} stroke-linecap="round" stroke-linejoin="round" />
        <path d="M156 66 H168 M164 62 l4 4 l-4 4" stroke={line} stroke-linecap="round" stroke-linejoin="round" />
        <path d="M234 66 H246 M242 62 l4 4 l-4 4" stroke={line} stroke-linecap="round" stroke-linejoin="round" />
        <path d="M47 86 V106 H277 V86" stroke={soft} stroke-dasharray="3 3" />
        <circle cx="160" cy="106" r="9" fill="var(--color-canvas)" stroke={accent} />
        <path d="M156 106 l3 3 l5 -6" stroke={accent} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        <text x="160" y="30" text-anchor="middle" font-size="9" fill={text}>{d.automated}</text>
      </g>
    )}
  </svg>
</div>
